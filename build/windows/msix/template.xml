<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="vinpn.exe"
        Arguments=""
        InstallLocation="C:\Program Files\VinPN\VinPN">
    </Installer>
    <PackageInformation
        PackageName="VinPN"
        PackageDisplayName="VinPN"
        PublisherName="CN=VinPN"
        PublisherDisplayName="VinPN"
        Version="0.1.0.0"
        PackageDescription="VinPN - Secure DNS client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.sickyturtlez.vinpn"
                Description="VinPN - Secure DNS client"
                DisplayName="VinPN"
                ExecutableName="vinpn.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>VinPN</DisplayName>
            <PublisherDisplayName>VinPN</PublisherDisplayName>
            <Description>VinPN - Secure DNS client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="vinpn.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
